# Copia a .env (ignorado por git) solo si necesitas cambiar los valores por defecto del
# Makefile. Nunca pongas llaves reales en este archivo: el repo es público.
DATABASE_URL=postgresql+psycopg://pcre:pcre@127.0.0.1:5432/pcre
APP_ENV=dev
APP_NAME=PCRE
# APP_ORIGIN=https://<app>.herokuapp.com   # obligatoria con APP_ENV=prod
LOG_LEVEL=INFO
LOG_SALT=<valor aleatorio solo en producción>
CONSENT_VERSION=borrador-2026-10
PRIVACY_CONTACT_EMAIL=<correo de contacto>
